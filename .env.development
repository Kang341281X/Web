PORT=3001
DB_PATH=./server/data.db
JWT_SECRET=local-development-jwt-secret-please-change-before-production
JWT_EXPIRES_IN=8h
CUSTOMER_JWT_SECRET=local-development-customer-jwt-secret-please-change-before-production
CUSTOMER_JWT_EXPIRES_IN=7d
# 公共资源拼接绝对地址时使用的前缀（仅对 /uploads/ 开头的后端上传文件生效，
# /assets/ 前端内置资源由 storageService.getUrl 保持相对路径，见 server/services/storageService.js）。
# 开发环境：指向后端 3001。跨源 <img> 加载由 server/index.js 对 /uploads 单独放开的
# Cross-Origin-Resource-Policy: cross-origin 允许，无需与前端页面同源。
# 生产环境：改为线上域名或 CDN（不要留 localhost，否则用户访问时仍会跨源）
PUBLIC_BASE_URL=http://localhost:3001
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5173
FRONTEND_PRODUCT_DETAIL_URL=http://localhost:5173/product
