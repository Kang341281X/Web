PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=shopping_admin
DB_CONNECTION_LIMIT=10
JWT_SECRET=local-development-jwt-secret-please-change-before-production
JWT_EXPIRES_IN=8h
# 公共资源（商品图、头像等）拼接绝对地址时使用的前缀。
# 必须与前端页面 origin 保持一致，否则 <img> 会跨源加载，触发 Chrome / Edge / WebKit
# 等浏览器的 ORB（Opaque Response Blocking）拦截 SVG 响应，导致商品图与占位图全部丢失。
# 开发环境：Vite dev server = 5173，与页面同源
# 生产环境：改为线上域名或 CDN（不要留 localhost，否则用户访问时仍会跨源）
PUBLIC_BASE_URL=http://localhost:5173
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5173
FRONTEND_PRODUCT_DETAIL_URL=http://localhost:5173/product
