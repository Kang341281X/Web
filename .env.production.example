PORT=3001
# SQLite 数据库文件路径（建议使用绝对路径或部署挂载目录）
DB_PATH=/var/lib/yourshop/data.db
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=8h
# 顾客端独立密钥（必须配置，且与 JWT_SECRET 不同，防止顾客 token 访问后台接口）
CUSTOMER_JWT_SECRET=replace-with-another-long-random-production-secret
CUSTOMER_JWT_EXPIRES_IN=7d
PUBLIC_BASE_URL=https://api.yourshop.com
UPLOAD_DIR=/var/lib/yourshop/uploads
CORS_ORIGIN=https://yourshop.com
FRONTEND_PRODUCT_DETAIL_URL=https://yourshop.com/product
# 反向代理层数：挂在 Nginx 等反向代理后面时设为 1（让限流拿到真实客户端 IP）。
# 未设置时默认不信任任何代理（false）；本地直连开发也设 false。
TRUST_PROXY=1

# 是否在生产库中注入演示分类/商品（006/009 迁移）。默认（未设置）在生产环境跳过，保持库干净。
# 仅在确实需要演示数据时显式设为 1；开发环境不受此变量影响、始终注入演示数据。
# SEED_DEMO_DATA=1
