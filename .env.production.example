PORT=3001
# SQLite 数据库文件路径（建议使用绝对路径或部署挂载目录）
DB_PATH=/var/lib/yourshop/data.db
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=8h
PUBLIC_BASE_URL=https://api.yourshop.com
UPLOAD_DIR=/var/lib/yourshop/uploads
CORS_ORIGIN=https://yourshop.com
FRONTEND_PRODUCT_DETAIL_URL=https://yourshop.com/product
